<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <include
        android:id="@+id/header"
        layout="@layout/view_page_header" />

    <!--
      The root above is focusable so it, not this field, takes focus when the
      screen opens; otherwise the keyboard appears before the user has asked to
      search. Tapping the field still focuses it normally.
    -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingStart="12dp" android:paddingEnd="12dp" android:orientation="horizontal">
        <Button android:id="@+id/filterThirdParty" android:layout_width="0dp" android:layout_height="wrap_content"
            android:minHeight="@dimen/app_filter_height" android:layout_weight="1"
            android:textSize="@dimen/app_filter_text" android:text="@string/wm_third_party" 
            android:layout_margin="4dp" android:background="@drawable/wm_filter_background"
            android:padding="8dp" android:textAllCaps="false" />
        <Button android:id="@+id/filterFactory" android:layout_width="0dp" android:layout_height="wrap_content"
            android:minHeight="@dimen/app_filter_height" android:layout_weight="1"
            android:textSize="@dimen/app_filter_text" android:text="@string/wm_factory_category" 
            android:layout_margin="4dp" android:background="@drawable/wm_filter_background"
            android:padding="8dp" android:textAllCaps="false" />
        <Button android:id="@+id/filterAll" android:layout_width="0dp" android:layout_height="wrap_content"
            android:minHeight="@dimen/app_filter_height" android:layout_weight="1"
            android:textSize="@dimen/app_filter_text" android:text="@string/wm_all_apps" 
            android:layout_margin="4dp" android:background="@drawable/wm_filter_background"
            android:padding="8dp" android:textAllCaps="false" />
    </LinearLayout>
    <EditText
        android:id="@+id/searchBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:background="@drawable/card_dark"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:hint="@string/search_apps"
        android:textSize="21sp"
        android:textColor="@color/text_primary"
        android:textColorHint="@color/text_secondary"
        android:inputType="text"
        android:imeOptions="actionSearch"
        android:maxLines="1"
        android:importantForAutofill="no" />

    <TextView
        android:id="@+id/frequentHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:text="@string/frequent"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/apps_heading_size"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/frequentGrid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:clipToPadding="false"
        android:orientation="horizontal"
        android:visibility="gone" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/appGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="16dp"
            android:scrollbars="vertical" />

        <TextView
            android:id="@+id/emptyState"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/no_apps"
            android:textColor="@color/text_secondary"
            android:textSize="21sp"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
