<?xml version="1.0" encoding="utf-8"?>
<com.dashline.launcher.AppTileLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:minHeight="@dimen/app_tile_height" android:padding="@dimen/app_tile_padding" android:gravity="center"
    android:orientation="vertical" android:clickable="true" android:focusable="true"
    android:background="?android:attr/selectableItemBackground">
    <ImageView android:id="@+id/factoryIcon" android:layout_width="@dimen/app_icon_size" android:layout_height="@dimen/app_icon_size"
        android:scaleType="fitCenter"
        android:tag="noTint" android:contentDescription="@string/app_icon" />
    <TextView android:id="@+id/factoryLabel" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/app_label_gap" android:gravity="center" android:minLines="2" android:maxLines="2"
        android:ellipsize="end" android:textColor="@color/text_primary" android:textSize="@dimen/app_label_size" />
    <TextView android:id="@+id/factoryStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center" android:textColor="@color/text_secondary" android:textSize="@dimen/app_status_size" />
</com.dashline.launcher.AppTileLayout>
