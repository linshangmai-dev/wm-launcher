<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="wm_vehicle_battery" translatable="false">电量</string>
    <string name="wm_vehicle_range" translatable="false">系统预估</string>
    <string name="wm_vehicle_trip_a" translatable="false">TRIP A</string>
    <string name="wm_vehicle_trip_b" translatable="false">TRIP B</string>
    <string name="wm_vehicle_total" translatable="false">总里程</string>
    <style name="TripStatLabel" parent="VehicleStatLabel">
        <item name="android:textSize">@dimen/trip_stat_label</item>
    </style>
    <style name="TripStatValue" parent="VehicleStatValue">
        <item name="android:textSize">@dimen/trip_stat_value</item>
    </style>
    <style name="VehicleStatColumn">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:orientation">vertical</item>
        <item name="android:gravity">center</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
    </style>
    <style name="VehicleStatLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/vehicle_stat_label</item>
    </style>
    <style name="VehicleStatValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">@dimen/vehicle_stat_value</item>
    </style>

    <string name="wm_vehicle_range_unknown" translatable="false">系统预估 -- km</string>
    <string name="wm_vehicle_range_inline" translatable="false">系统预估 %1$s</string>
    <string name="wm_actual_estimated_range_unknown" translatable="false">实际预估里程 -- km</string>
    <string name="wm_actual_estimated_range_inline" translatable="false">实际预估里程 %1$s</string>
    <string name="wm_trip_reset_unavailable" translatable="false">当前原厂接口只能读取小计，尚未找到仪表清零指令。请使用仪表原厂清零操作；数值更新后，桌面会自动同步。</string>
    <string name="wm_media_control_failed" translatable="false">暂时无法控制播放器，请先打开音乐应用。</string>
</resources>
