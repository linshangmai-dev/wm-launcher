<!--
  Logo: the launcher's own dashboard layout — one tall panel on the left, two
  stacked cards on the right. Geometry sits inside the adaptive-icon safe zone
  (the central 72dp of the 108dp viewport), so nothing is clipped by any mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Left panel -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M28,32 h22 a3,3 0 0 1 3,3 v38 a3,3 0 0 1 -3,3 h-22 a3,3 0 0 1 -3,-3 v-38 a3,3 0 0 1 3,-3 z" />

    <!-- Right upper card (accent = the media panel) -->
    <path
        android:fillColor="#5CB8F0"
        android:pathData="M58,32 h22 a3,3 0 0 1 3,3 v16 a3,3 0 0 1 -3,3 h-22 a3,3 0 0 1 -3,-3 v-16 a3,3 0 0 1 3,-3 z" />

    <!-- Right lower card -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M58,58 h22 a3,3 0 0 1 3,3 v12 a3,3 0 0 1 -3,3 h-22 a3,3 0 0 1 -3,-3 v-12 a3,3 0 0 1 3,-3 z" />

</vector>
